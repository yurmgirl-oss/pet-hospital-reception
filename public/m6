<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>접수 예상 소요시간 & 분류 관리 (m6)</title>
<style>
  :root {
    --primary: #16875a;
    --border: #e2e8f0;
    --bg: #f8fafc;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: "Pretendard", system-ui, sans-serif;
    background: #f1f5f9;
    padding: 12px;
    color: #1e293b;
  }
  .card {
    background: #fff;
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 12px;
    border: 1px solid var(--border);
    box-shadow: 0 2px 6px rgba(0,0,0,0.05);
  }
  h2 { font-size: 15px; font-weight: 900; margin-bottom: 10px; color: #0f172a; display: flex; align-items: center; justify-content: space-between; }
  .btn-refresh {
    background: var(--primary);
    color: #fff;
    border: none;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  /* 입력 폼 그리드 */
  .manual-form {
    display: grid;
    grid-template-columns: 1fr 1fr 90px 80px;
    gap: 6px;
    margin-top: 6px;
  }
  input, select {
    padding: 7px 10px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 13px;
    outline: none;
    width: 100%;
  }
  input:focus, select:focus { border-color: var(--primary); }
  .btn-add {
    background: #2563eb;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
  }

  /* 테이블 목록 */
  table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 12px; }
  th { background: #f8fafc; padding: 8px 6px; border-bottom: 1px solid var(--border); color: #64748b; font-weight: 800; }
  td { padding: 8px 6px; border-bottom: 1px solid #f1f5f9; text-align: center; }
  .btn-del {
    background: #ef4444;
    color: #fff;
    border: none;
    padding: 3px 6px;
    border-radius: 4px;
    font-size: 11px;
    cursor: pointer;
  }
  .btn-save-qr {
    background: #059669;
    color: #fff;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
  }
</style>
</head>
<body>

  <!-- [1] 우측 일반예약 직접 기재·추가 -->
  <div class="card">
    <h2>🏥 일반예약 직접 등록 (m5 우측 화면)</h2>
    <div class="manual-form">
      <input type="text" id="m-name" placeholder="동물명 (예: 초코)">
      <select id="m-category">
        <option value="일반진료">일반진료</option>
        <option value="예방접종">예방접종</option>
        <option value="외과수술">외과수술</option>
        <option value="치과/스케일링">치과/스케일링</option>
        <option value="피부/귀치료">피부/귀치료</option>
        <option value="정기검진">정기검진</option>
        <option value="미용/목욕">미용/목욕</option>
      </select>
      <input type="number" id="m-minutes" placeholder="소요(분)" value="15">
      <button class="btn-add" onclick="addManualBooking()">추가</button>
    </div>

    <!-- 일반예약 목록 -->
    <table id="table-manual">
      <thead>
        <tr>
          <th>순번</th>
          <th>동물명</th>
          <th>분류</th>
          <th>소요시간</th>
          <th>진료중</th>
          <th>삭제</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>

  <!-- [2] 원내 QR접수 환자 분류 & 소요시간 관리 -->
  <div class="card">
    <h2>
      <span>📱 QR접수 환자 소요시간 & 분류 관리</span>
      <button class="btn-refresh" onclick="loadQrList()">새로고침</button>
    </h2>
    <table id="table-qr">
      <thead>
        <tr>
          <th>순번</th>
          <th>동물명</th>
          <th>분류 선택</th>
          <th>소요시간(분)</th>
          <th>저장</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>

<script>
const API_BASE = "https://m5-api.yurmgirl.workers.dev";
const RECEPTION_API = "/api/receptions";

// --- 일반예약 직접 등록 로직 ---
function getManualBookings(){
  return JSON.parse(localStorage.getItem("m6_manual_bookings") || "[]");
}
function setManualBookings(data){
  localStorage.setItem("m6_manual_bookings", JSON.stringify(data));
  renderManualTable();
}

function addManualBooking(){
  const name = document.getElementById("m-name").value.trim();
  const category = document.getElementById("m-category").value;
  const minutes = document.getElementById("m-minutes").value.trim() || 15;
  if(!name){ alert("동물명을 입력하세요."); return; }

  const list = getManualBookings();
  list.push({ id: Date.now(), petName: name, category: category, minutes: Number(minutes), treating: false });
  setManualBookings(list);

  document.getElementById("m-name").value = "";
}

function deleteManualBooking(id){
  const list = getManualBookings().filter(item => item.id !== id);
  setManualBookings(list);
}

function toggleTreating(id){
  const list = getManualBookings().map(item => {
    if(item.id === id) item.treating = !item.treating;
    return item;
  });
  setManualBookings(list);
}

function renderManualTable(){
  const list = getManualBookings();
  const tbody = document.querySelector("#table-manual tbody");
  tbody.innerHTML = "";
  if(!list.length){
    tbody.innerHTML = `<tr><td colspan="6" style="color:#94a3b8; padding:16px;">등록된 일반예약이 없습니다.</td></tr>`;
    return;
  }
  list.forEach((item, idx) => {
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td>${idx + 1}</td>
      <td style="font-weight:900;">${item.petName}</td>
      <td><span style="background:#e2e8f0; padding:2px 6px; border-radius:4px; font-size:11px;">${item.category}</span></td>
      <td>${item.minutes}분</td>
      <td><input type="checkbox" ${item.treating ? "checked" : ""} onchange="toggleTreating(${item.id})"></td>
      <td><button class="btn-del" onclick="deleteManualBooking(${item.id})">삭제</button></td>
    `;
    tbody.appendChild(tr);
  });
}

// --- QR접수 분류 및 소요시간 관리 ---
async function loadQrList(){
  try {
    const [r, e] = await Promise.all([
      fetch(RECEPTION_API, { cache: "no-store" }),
      fetch(API_BASE + "/estimates", { cache: "no-store" })
    ]);
    const receptions = r.ok ? await r.json() : [];
    const estimateData = e.ok ? await e.json() : {};
    const items = Array.isArray(receptions) ? receptions : (receptions.items || []);
    
    const savedCategories = JSON.parse(localStorage.getItem("m6_categories") || "{}");
    const estimates = estimateData.estimates || {};

    const tbody = document.querySelector("#table-qr tbody");
    tbody.innerHTML = "";

    const activeList = items.filter(i => !["완료","진료완료","취소"].includes(i.status || ""));
    if(!activeList.length){
      tbody.innerHTML = `<tr><td colspan="5" style="color:#94a3b8; padding:16px;">대기 중인 QR접수가 없습니다.</td></tr>`;
      return;
    }

    activeList.forEach((item, idx) => {
      const key = String(item.id ?? item.reception_id ?? "");
      const currentCat = savedCategories[key] || item.disease || "일반진료";
      const currentMin = estimates[key] || 15;

      const tr = document.createElement("tr");
      tr.innerHTML = `
        <td>${idx + 1}</td>
        <td style="font-weight:900;">${item.pet_name || item.animal_name || "이름 미입력"}</td>
        <td>
          <select id="cat-${key}">
            <option value="일반진료" ${currentCat==="일반진료"?"selected":""}>일반진료</option>
            <option value="예방접종" ${currentCat==="예방접종"?"selected":""}>예방접종</option>
            <option value="외과수술" ${currentCat==="외과수술"?"selected":""}>외과수술</option>
            <option value="치과/스케일링" ${currentCat==="치과/스케일링"?"selected":""}>치과/스케일링</option>
            <option value="피부/귀치료" ${currentCat==="피부/귀치료"?"selected":""}>피부/귀치료</option>
            <option value="정기검진" ${currentCat==="정기검진"?"selected":""}>정기검진</option>
          </select>
        </td>
        <td>
          <input type="number" id="min-${key}" value="${currentMin}" style="width:70px; text-align:center;">
        </td>
        <td>
          <button class="btn-save-qr" onclick="saveQrItem('${key}')">저장</button>
        </td>
      `;
      tbody.appendChild(tr);
    });
  } catch (err) {
    console.error(err);
  }
}

// 개별 QR 환자 분류 및 소요시간 저장
async function saveQrItem(key){
  const cat = document.getElementById(`cat-${key}`).value;
  const min = Number(document.getElementById(`min-${key}`).value);

  // 1. 분류 로컬 저장
  const savedCategories = JSON.parse(localStorage.getItem("m6_categories") || "{}");
  savedCategories[key] = cat;
  localStorage.setItem("m6_categories", JSON.stringify(savedCategories));

  // 2. 소요시간 백엔드 서버 저장
  try {
    await fetch(API_BASE + "/estimates", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ key: key, minutes: min })
    });
  } catch(e) { console.error(e); }

  alert("저장되었습니다! m5 화면에 즉시 반영됩니다.");
}

renderManualTable();
loadQrList();
</script>
</body>
</html>
